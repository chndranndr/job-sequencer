{
  "name": "job-sequencer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "start": "node dist/server/server/start.js",
    "build": "tsc -p tsconfig.server.json && vite build",
    "format": "git diff --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run format && npm run typecheck && npm run harness:check",
    "test": "node --import=tsx --test tests/*.test.ts",
    "eval": "node --import=tsx --test tests/ai-fixtures.test.ts tests/server.test.ts",
    "harness:check": "node --import=tsx scripts/harness.ts check",
    "doctor": "node --import=tsx scripts/harness.ts doctor",
    "gc": "node --import=tsx scripts/harness.ts gc",
    "smoke": "node --import=tsx scripts/smoke.ts",
    "smoke:latex": "node --import=tsx scripts/latex-smoke.ts",
    "smoke:browser": "node --import=tsx scripts/browser-smoke-tracker.ts",
    "smoke:browser:tracker": "node --import=tsx scripts/browser-smoke-tracker.ts",
    "test:vendor:freehire": "bun test --timeout 30000 vendor/ai-job-search-skills/freehire-search/cli/tests",
    "live:scrape": "node --import=tsx scripts/live-scrape.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@fastify/multipart": "^10.1.0",
    "fastify": "5.6.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typebox": "1.3.7",
    "word-extractor": "^1.0.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "playwright": "1.62.1",
    "tsx": "4.19.3",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}
